<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoBrightness.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SettingNumber" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,8,32,32" Spacing="16" MaxWidth="900">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Measuring" Style="{StaticResource CardHeaderStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Seconds between readings" />
                            <TextBlock Text="The camera opens for about half a second per reading; its light blinks each time." Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox x:Name="IntervalBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="10" Maximum="600" SmallChange="5" LargeChange="30" ValueChanged="OnNumberChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Brightening response (seconds)" />
                            <TextBlock Text="How quickly readings follow the room getting brighter." Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox x:Name="BrightenBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="0" Maximum="600" SmallChange="5" ValueChanged="OnNumberChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dimming response (seconds)" />
                            <TextBlock Text="Slower dimming avoids reacting to someone walking past or a passing cloud." Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox x:Name="DimBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="0" Maximum="1800" SmallChange="10" ValueChanged="OnNumberChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Brightness changes" Style="{StaticResource CardHeaderStyle}" />
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap"
                               Text="Many monitors save every brightness change to memory that wears out after roughly 100,000 writes. These limits keep automatic changes infrequent." />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Smallest change worth making (%)" VerticalAlignment="Center" />
                        <NumberBox x:Name="MinStepBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="1" Maximum="20" ValueChanged="OnNumberChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Minimum seconds between changes" VerticalAlignment="Center" />
                        <NumberBox x:Name="MinIntervalBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="0" Maximum="3600" SmallChange="10" ValueChanged="OnNumberChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Changes per day" />
                            <TextBlock Text="After this, only large changes are made." Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="BudgetBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="10" Maximum="2000" SmallChange="10" ValueChanged="OnNumberChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Large change (%)" />
                            <TextBlock Text="Changes at least this big are applied immediately, ignoring the limits above." Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox x:Name="BigStepBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="5" Maximum="100" ValueChanged="OnNumberChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Learning" Style="{StaticResource CardHeaderStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Learn from my adjustments" />
                            <TextBlock Text="When you change brightness in Twinkle Tray, add it to the curve at the current light level." Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LearnToggle" Grid.Column="1" Toggled="OnToggleChanged" MinWidth="0" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause after a manual change (minutes)" />
                            <TextBlock Text="In Automatic mode, leave your choice alone for this long." Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <NumberBox x:Name="PauseBox" Grid.Column="1" Style="{StaticResource SettingNumber}" Minimum="0" Maximum="480" SmallChange="5" ValueChanged="OnNumberChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Monitors" Style="{StaticResource CardHeaderStyle}" />
                        <Button HorizontalAlignment="Right" Click="OnRefreshMonitors" ToolTipService.ToolTip="Ask Twinkle Tray again">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource MetricCaptionStyle}" TextWrapping="Wrap"
                               Text="Offset is added to the curve for monitors that look brighter or dimmer than the others. Minimum and maximum limit what is set automatically." />
                    <StackPanel x:Name="MonitorList" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="General" Style="{StaticResource CardHeaderStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Text="Starts in the notification area when you sign in." Style="{StaticResource MetricCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="OnStartupToggled" MinWidth="0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open data folder" Click="OnOpenDataFolder" />
                        <TextBlock x:Name="DataFolderText" VerticalAlignment="Center" Style="{StaticResource MetricCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
